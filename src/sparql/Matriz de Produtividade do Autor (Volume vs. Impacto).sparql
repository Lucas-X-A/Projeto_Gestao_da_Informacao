PREFIX cti: <http://gic.ufrpe.br/cti/vocabulary/cti#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?nomeAutor ?totalProducoes ?indiceH ?indiceI10 ?totalCitacoes
WHERE {
  ?autor a cti:Autor ;
         cti:nm_pessoa ?nomeAutor .
  
  # Subconsulta para contagem de volume
  {
    SELECT ?autor (COUNT(?prod) AS ?totalProducoes)
    WHERE { ?autor cti:autoria ?prod . }
    GROUP BY ?autor
  }

  # Join explícito dentro do opcional para evitar produto cartesiano[cite: 2]
  OPTIONAL {
    ?autor cti:mensurado ?citacao .    # Vinculação necessária[cite: 12]
    ?citacao cti:nr_indice_h ?indiceH ;
             cti:nr_indice_i10 ?indiceI10 ;
             cti:nr_citacoes_autor ?totalCitacoes .
  }
}
ORDER BY DESC(xsd:integer(?indiceH)) DESC(?totalProducoes)