PREFIX cti: <http://gic.ufrpe.br/cti/vocabulary/cti#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?ano ?nivel ?faixaIndiceH ?ordemFaixa (COUNT(DISTINCT ?autor) AS ?quantidade)
WHERE {
  ?discente a cti:Discente ;
            cti:id_pessoa ?idPessoa ;
            cti:ds_grau_academico_discente ?nivel ;
            cti:an_titulacao ?ano ;
            cti:vinculado ?ppg .

  ?ppg cti:sediado ?ict .
  ?ict cti:sg_entidade_ensino "UFRPE" .

  ?autor a cti:Autor ;
         cti:id_pessoa ?idPessoa ;
         cti:mensurado ?citacao .

  ?citacao cti:nr_indice_h ?indiceH .

  FILTER(xsd:integer(?ano) >= {ano_inicio} && xsd:integer(?ano) <= {ano_fim})
  FILTER(BOUND(?indiceH))

  BIND(
    IF(xsd:integer(?indiceH) <= 5, 1,
    IF(xsd:integer(?indiceH) <= 15, 2,
    IF(xsd:integer(?indiceH) <= 30, 3,
    4))) AS ?ordemFaixa
  )

  BIND(
    IF(xsd:integer(?indiceH) <= 5, "0-5 - Iniciante",
    IF(xsd:integer(?indiceH) <= 15, "6-15 - Consolidado",
    IF(xsd:integer(?indiceH) <= 30, "16-30 - Líder",
    "30+ - Elite"))) AS ?faixaIndiceH
  )
}
GROUP BY ?ano ?nivel ?faixaIndiceH ?ordemFaixa
ORDER BY ?ano ?nivel ?ordemFaixa
